# Your existing Gemini key remains on the server. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas connection string (or a local MongoDB deployment for development).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cardflow

# Phase 2B: connect a PRIVATE Vercel Blob store to your project.
# The read/write token must be server-only. Required for client upload token exchange,
# local development, and the maintenance cleanup script.
BLOB_READ_WRITE_TOKEN=your_private_blob_read_write_token
# Vercel may also automatically provide BLOB_STORE_ID and VERCEL_OIDC_TOKEN.
# Local client-upload callbacks need a publicly reachable tunnel in development:
# VERCEL_BLOB_CALLBACK_URL=https://your-tunnel.example
